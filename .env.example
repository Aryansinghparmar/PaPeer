# Required application credentials. Never commit the real .env file.
OPENAI_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# LangSmith tracing. Set LANGSMITH_TRACING=true only when you want traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=papeer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Cost-controlled model and retrieval settings. Unset values use the defaults
# in backend/config.py (chat/rename/eval model: gpt-6-luna).
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_RENAME_MODEL=gpt-6-luna
# OPENAI_EVAL_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=3
MAX_RETRIEVAL_ATTEMPTS=3
MAX_QUERY_REWRITES=1

# ── Web API (api/) ────────────────────────────────────────────────────────────
# AUTH_MODE: none (local dev only) | api_key | easyauth (only behind Azure Easy
# Auth with ingress restricted to it; see docs/DEPLOYMENT.md). Left unset it is
# "none" for a local uvicorn run and "api_key" under docker compose.
# AUTH_MODE=api_key
# Shared access code for AUTH_MODE=api_key (8+ chars). Sent by the SPA as
# "Authorization: Bearer <code>". Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
PAPEER_ACCESS_CODE=
# Browser origins allowed to call the API cross-origin (Vite dev server).
# Not needed when the SPA is served by the API itself (Docker / cloud).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built SPA served at / when the folder exists (npm run build in frontend/).
# STATIC_DIR=frontend/dist

# Daily ceiling on estimated OpenAI spend across all users (UTC day, from the
# observability/runs.jsonl ledger). 0 disables. Also set a hard budget on the
# OpenAI project itself; this estimate is not a billing guarantee.
DAILY_BUDGET_USD=1.00
# Requests per principal per window (in-memory, per process).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT=10
RATE_LIMIT_BTW=10
RATE_LIMIT_DOCUMENTS=10
RATE_LIMIT_SESSIONS=30
# Streaming: SSE heartbeat interval and overall per-request timeout.
HEARTBEAT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=180
# Input and upload limits.
MAX_MESSAGE_CHARS=4000
MAX_BTW_QUERY_CHARS=2000
MAX_UPLOAD_MB=20
MAX_FILES_PER_REQUEST=5
MAX_URLS_PER_REQUEST=5
MAX_CHUNKS_PER_DOCUMENT=2000
MAX_PDF_PAGES=500

# Local state paths (defaults shown; the Docker image sets them under /data,
# so leave them commented when this file is used as a compose env_file).
# EMBEDDING_CACHE_DIR=embedding_cache
# CHECKPOINT_DB_PATH=checkpoints.db
# SESSIONS_FILE=sessions.json
# METRICS_DIR=observability
LOCAL_METRICS_ENABLED=true
LOG_LEVEL=INFO
