# Required application credentials. Never commit the real .env file.
OPENAI_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# LangSmith tracing. Set LANGSMITH_TRACING=true only when you want traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=papeer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Cost-controlled model and retrieval settings.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_RENAME_MODEL=gpt-5-mini
OPENAI_EVAL_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=3
MAX_RETRIEVAL_ATTEMPTS=3
MAX_QUERY_REWRITES=1

# Local state and measurements.
EMBEDDING_CACHE_DIR=embedding_cache
CHECKPOINT_DB_PATH=checkpoints.db
METRICS_DIR=observability
LOCAL_METRICS_ENABLED=true
LOG_LEVEL=INFO
