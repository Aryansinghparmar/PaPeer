# Base URL of the FastAPI backend (api/main.py). No trailing slash.
# Leave empty for same-origin requests: in production the API serves/sits beside
# the SPA, and in `npm run dev` the Vite proxy forwards /api and /health.
# Set it only to call a backend on another origin directly (needs CORS).
VITE_API_BASE_URL=

# Dev server only (`npm run dev`): where the Vite proxy sends /api and /health.
# Defaults to http://127.0.0.1:8000.
API_PROXY_TARGET=http://127.0.0.1:8000
